root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,jsonc,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.ps1]
end_of_line = crlf

# The scene-graph schema is generated into three languages — keep it byte-stable.
[contract/*.schema.json]
insert_final_newline = true
indent_size = 2
