# =============================================================================
# postmarkTrip · 环境变量模板
#
#   cp .env.example .env          （Windows: Copy-Item .env.example .env）
#
# 然后**至少**改掉这三项（都以前缀 CHANGE_ME 标记，doctor 会检查）：
#
#   SECRET_KEY         会话签名密钥 —— 泄露等于任何人可伪造登录
#   ADMIN_PASSWORD     管理员口令
#   POSTGRES_PASSWORD  数据库口令（改完记得同步改 DATABASE_URL 里的那一段）
#
# ⚠️ 约定
#   * .env 已被 .gitignore 排除，**绝不要提交**。
#   * 值请用 ASCII。中文写在注释里，别写进值里（避免各平台编码差异）。
#   * 本文件必须存为 **UTF-8 无 BOM**。带 BOM 会让第一个变量的名字变成
#     "\ufeffAPP_ENV"，表现为"这个变量明明设了却读不到"。
#   * 不要在值里用引号包裹，dotenv 与 Compose 会把它当成值的一部分。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 基础
# -----------------------------------------------------------------------------

# 运行环境：prod | dev
# dev 会放宽日志与错误细节；生产保持 prod。
APP_ENV=prod

# **对外**端口。浏览器访问 http://<主机>:9999
# 注意：这是 gateway 映射到宿主机的端口，不是容器内的监听端口（容器内固定 8000）。
APP_PORT=9999

# 绑定的宿主网卡。
#   0.0.0.0   局域网内其他设备也能访问（默认）
#   127.0.0.1 只允许本机访问（更安全，但手机/平板就连不上了）
APP_HOST_BIND=0.0.0.0

# 可选：把 Postgres 数据放到宿主机目录。留空 = 命名卷 postmarktrip-db（默认，推荐）。
# 设了它就走绑定挂载 —— 路径必须在 ext4 上、目录需**先存在**、属主 999。
# 新用户不要动这一行。
PMTRIP_PGDATA=

# 镜像来源。留空 = 本地构建（postmarktrip/api:local）。
# 想直接拉 GitHub 构建好的镜像（见 .github/workflows/release.yml）：
#   PMTRIP_API_REPO=ghcr.io/<owner>/postmarktrip-api
#   PMTRIP_GATEWAY_REPO=ghcr.io/<owner>/postmarktrip-gateway
#   PMTRIP_TAG=0.1.0
# 然后：docker compose pull && docker compose up -d --no-build
PMTRIP_API_REPO=
PMTRIP_GATEWAY_REPO=
# 镜像 tag。留空 = local（配合本地构建）。
PMTRIP_TAG=

# 时区。影响日志时间戳与界面显示；数据库内部仍存 UTC。
TZ=Asia/Shanghai

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 日志格式。true = 单行 JSON（便于采集）；false = 人类可读（便于盯着看）。
# 开发时建议 false。
LOG_JSON=true


# -----------------------------------------------------------------------------
# 2. 会话与安全
# -----------------------------------------------------------------------------

# ⚠️ 必须改！会话 cookie 的签名密钥。
#
# 生成方式（任选其一）：
#   Linux / macOS / WSL :  openssl rand -base64 48
#   Windows PowerShell  :  $b=New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   PowerShell 7        :  $b=[byte[]]::new(48); [System.Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
#
# 改这个值 = 所有已登录会话立即失效（需要重新登录）。这是预期行为。
SECRET_KEY=CHANGE_ME_run_openssl_rand_base64_48

# 会话有效期（秒）。默认 2592000 = 30 天。
SESSION_MAX_AGE=2592000

# 会话 cookie 是否只走 HTTPS。
# 局域网 HTTP 部署必须是 false，否则浏览器不会回传 cookie，表现为"登录后仍是未登录"。
# 只有在你前面挂了 HTTPS 反向代理时才改成 true。
COOKIE_SECURE=false

# 网关注入的 X-Forwarded-* 是否可信。
# 默认 * 表示信任（因为只有 gateway 能连到 api，它不在宿主上暴露端口）。
# 若你把 api 端口也映射出去了，请改成具体网段，例如 172.16.0.0/12。
# 注意：本项由 docker-compose.yml 读取，不通过 env_file 传入。
FORWARDED_ALLOW_IPS=*


# -----------------------------------------------------------------------------
# 3. 管理员账号（首次启动时创建）
# -----------------------------------------------------------------------------

ADMIN_USER=admin

# ⚠️ 必须改！至少 8 位。
# 只在 app_user 表**为空**时使用；之后改这里不会覆盖已有口令，
# 想改口令请登录后在界面里改。
ADMIN_PASSWORD=CHANGE_ME_set_a_strong_password


# -----------------------------------------------------------------------------
# 4. 路径（**容器内**路径，不是宿主路径）
#
# 宿主目录的映射写在 docker-compose.yml 的 volumes 里：
#     ./data/assets -> /data/assets
#     ./inbox       -> /inbox
#     ./public-data -> /public-data
#     ./models      -> /models
# 除非你改了 compose，否则这里保持默认。
# -----------------------------------------------------------------------------

DATA_DIR=/data
INBOX_DIR=/inbox
PUBLIC_DATA_DIR=/public-data
MODELS_DIR=/models


# -----------------------------------------------------------------------------
# 4b. 投递目录监听（v1.0 · 路径 A）
#
# 扫描仪 → 扫描软件 → INBOX_DIR → 自动进 L0 资产。
# 处理成功后原文件被**移动**到 inbox/processed/，失败移到 inbox/failed/ ——
# 原文件不会被删除或修改。
#
# ⚠️ 默认 false。打开它意味着 worker 会持续轮询该目录，
#    一个未预期的开关不该在升级后悄悄开始动你的文件。
# -----------------------------------------------------------------------------

# true 时启用监听。启用前请确认 worker 心跳正常（make doctor 会报）。
INBOX_ENABLED=false

# 轮询间隔（秒）。刻意用轮询而不是 inotify：投递箱常常是 SMB / drvfs 挂载，
# 网络文件系统上的事件通知在各 NAS 实现下表现不一，甚至完全不穿过来。
# 5 秒 = 一天 17280 次列目录，代价可忽略，换来的是任何挂载方式下都成立的行为。
INBOX_POLL_SECONDS=5


# -----------------------------------------------------------------------------
# 4c. 挂载目录的属组（Linux / WSL 上重要）
#
# 容器里的应用以 pmtrip(10001) 运行，而 data/assets、inbox 是绑定挂载的
# **宿主目录**。要让两边都能写，做法是把这两个目录设成 HOST_GID 这个组 +
# 组写权限 + setgid，并把容器的 pmtrip 用户加入该组。
#
# ⚠️ 以前这里是直接 `chown pmtrip:pmtrip` 宿主目录 —— 那会**夺走宿主用户的
#    写权限**，随之坏掉的是 `make backup` 的资产清单、宿主侧 rsync 备份、
#    以及你手工往 assets / inbox 里放文件。容器自己能写并不代表那样没问题：
#    宿主目录是用户的东西，容器不该改它的归属。
#
# 默认 1000（多数 Linux/WSL 第一个用户的 gid）。查自己的：
#     id -g
# 留 0 表示不建组、只加组写权限（宿主 gid 不可知时的安全退化）。
# -----------------------------------------------------------------------------

HOST_GID=1000


# -----------------------------------------------------------------------------
# 5. 数据库
#
# ⚠️ DATABASE_URL 里的口令必须与 POSTGRES_PASSWORD 一致（doctor 会核对）。
# POSTGRES_* 供数据库容器初始化使用；DATABASE_URL 供应用使用。
# 主机名 db 是 compose 的服务名，容器间通过它解析。
# -----------------------------------------------------------------------------

POSTGRES_USER=postmarktrip
POSTGRES_PASSWORD=CHANGE_ME_set_a_db_password
POSTGRES_DB=postmarktrip

DATABASE_URL=postgresql+psycopg://postmarktrip:CHANGE_ME_set_a_db_password@db:5432/postmarktrip

# 任务队列。库号 0 即可，不要与数据库混用同一个 Redis 实例的另一套 key 前缀。
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# 6. 扫描与卡片
# -----------------------------------------------------------------------------

# 扫描件元数据里没有 DPI 时的兜底值。
# 管线本身兼容 300 / 600 / 1200（按 DPI 归一化所有毫米阈值），这里只是缺省。
DEFAULT_SCAN_DPI=600

# 卡片标准尺寸（毫米）。实测的邮政成品卡约为 54 × 90。
# ⚠️ 仅用于"切分结果的合理性校验"，**不做硬拒绝** ——
#    官方的明信片标准（YZ/T 0190-2023）之外还有大量自制卡，异形卡不能被拦住。
CARD_WIDTH_MM=54
CARD_HEIGHT_MM=90

# 上传体积上限（字节）。默认 104857600 = 100 MiB。
# ⚠️ 必须与 infra/gateway/nginx.conf 的 client_max_body_size 保持一致，
#    否则会出现"应用收下了但网关先拦掉"这种半截失败。改这里就要同步改那里。
MAX_UPLOAD_BYTES=104857600


# -----------------------------------------------------------------------------
# 7. 识别 Provider —— **全部可选**
#
# 一个都不填，系统依然完整可用（这是刻意的设计：默认全本地）。
# 关掉所有云端 Provider 只会降低精度，不会让功能不可用。
# -----------------------------------------------------------------------------

# OCR 引擎：none | rapidocr | paddleocr
# v0.1 不含识别功能，也没有安装 [recognition] extra，因此默认 none。
# v1.0 起建议改成 rapidocr（CPU 友好，无需 GPU）。
#
# ⚠️ 这个名字有历史遗留：**`PMTRIP_OCR_ENGINE` 也认**（两个都设时以带前缀的
#    那个优先）。原因见 docs/ok/12 §三之 7 —— 文档与识别端点的 503 报错一直
#    让用户设带前缀的名字，而代码只读这里的名字，于是"照文档做还是 503"。
#    现在两个都认，随便用哪个；新配置建议用这个不带前缀的。
OCR_ENGINE=none

# Colnect 邮票目录 API Key。
# 申请：https://colnect.com/en/capi/apply_for_key （个人项目可获批）
# 不填 = 不启用目录查询，邮票信息只能靠 OCR + 手工。
# ⚠️ 使用 Colnect 数据**必须署名**（见 public-data/README.md）。
COLNECT_API_KEY=

# M3C-5：colnetApi 独立服务（不是 Colnect CAPI key）
#
# ⚠️ 这个服务**不在本仓库里**，绝大多数部署也没有它。所以默认关闭：
#    没装服务却打开，只会让「识别邮票」按钮点了报错。
#    自己跑起了那套服务时，把它设为 true。
COLNET_ENABLED=false
# Docker Desktop 默认用 host.docker.internal；共享 Docker 网络时可改成 http://colnetapi:8765
COLNET_API_URL=http://host.docker.internal:8765
COLNET_API_TIMEOUT_S=90

# 多模态大模型（疑难件**手动**送云端用，见设计决策 D5）。
# 默认关闭；即便打开，也只在用户显式点击时调用，不会自动 fallback。
VLM_PROVIDER=deepseek
VLM_ENABLED=false
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# 扫描 Agent（v1.1）。跑在"USB 线插着的那台机器"上。
# Profile W（Docker Desktop）下宿主机的 Agent 用 host.docker.internal 访问。
AGENT_URL=
AGENT_TOKEN=


# -----------------------------------------------------------------------------
# 8. 备份
# -----------------------------------------------------------------------------

# 数据库转储保留天数。0 = 永久保留（不推荐，磁盘会一直长）。
BACKUP_KEEP_DAYS=30


# -----------------------------------------------------------------------------
# 9. 高级 / 排障（一般不用改）
# -----------------------------------------------------------------------------

# uvicorn 的导入路径。应用模块若改名，改这里即可，**不需要重建镜像**。
API_APP=postmarktrip.main:app

# 镜像标签。留空则用 local。发布版可设为具体版本号以便回滚。
PMTRIP_TAG=local

# 开发用（docker-compose.dev.yml）。
#
# WEB_DEV_PORT 由 apps/web/vite.config.ts 读取（它从**仓库根**的 .env 读），
# 所以改这里前端 dev server 真的会跟着变 —— 而不是只有运维脚本打印提示时用一下。
# 同理，APP_PORT 变了，dev server 的 /api 代理目标也会自动跟着变。
WEB_DEV_PORT=5173

# 分离式网关的静态目录（infra/compose/gateway-standalone.yml）
WEB_STATIC_DIR=./apps/web/dist

# SMB 投递箱（infra/compose/inbox-smb.yml.example，Profile L）
SMB_DEVICE=
SMB_USER=
SMB_PASSWORD=


# -----------------------------------------------------------------------------
# 10. 明确**不在这里**的配置
#
#   API_HOST / API_PORT   容器内监听地址，固定 0.0.0.0:8000，由 compose 传入。
#                         要让外部访问请改 APP_PORT / APP_HOST_BIND。
#   POSTGRES_INITDB_ARGS  由 compose 固定为 UTF8（中文地名与戳面原文依赖它）。
#   PGDATA                由 compose 固定，避免绑定挂载点上的杂物干扰 initdb。
# -----------------------------------------------------------------------------
